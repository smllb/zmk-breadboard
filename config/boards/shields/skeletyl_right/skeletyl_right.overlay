#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        
        // RIGHT HALF MAPPING - maps to the second half of each row in the keymap
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   // Right top row
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   // Right middle row
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   // Right bottom row
            RC(3,0) RC(3,1) RC(3,2)                   // Right thumb keys
        >;
        
        col-offset = <5>;  // Offset by 5 columns to map to the right half of each row
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        
        col-gpios
            = <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            ;
            
        row-gpios
            = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
