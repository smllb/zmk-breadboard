#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Y &kp U &kp I &kp O &kp P
                &kp H &kp J &kp K &kp L &bt BT_CLR
                &kp N &kp M &bt BT_SEL 0 &bt BT_SEL 1 &bootloader
                &kp BSPC &kp ENTER &kp ENTER &kp ENTER &kp ENTER
            >;
        };

        func_layer {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp TAB
                &kp GRAVE &kp MINUS &kp EQUAL &kp LBKT &kp RBKT
                &trans &trans &trans &trans &trans
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };
    };
};