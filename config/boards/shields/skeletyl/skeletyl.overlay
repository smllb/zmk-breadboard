#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios = 
                    
                    <&gpio1 11 GPIO_ACTIVE_HIGH>,
                    <&gpio0 22 GPIO_ACTIVE_HIGH>,
                    <&gpio0 20 GPIO_ACTIVE_HIGH>,
                    <&gpio0 6 GPIO_ACTIVE_HIGH>,
                    <&gpio0 8 GPIO_ACTIVE_HIGH>;

        row-gpios = 
                    <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <8>;  // 4 rows × 2 (left + right)
        columns = <5>;

        // Full split keyboard mapping, 36 keys total in the transform
        // But we only have 30 actual keys (18 on main grid + 12 thumb keys)
        map = <
            // Left half keys (0-17)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    // Left top row: 0-4
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    // Left middle row: 5-9  
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    // Left bottom row: 10-14
                           RC(3,2) RC(3,3) RC(3,4)     // Left thumb keys: 15-17
            
            // Right half keys (18-35)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)    // Right top row: 18-22
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)    // Right middle row: 23-27
            RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4)    // Right bottom row: 28-32
            RC(7,0) RC(7,1) RC(7,2)                    // Right thumb keys: 33-35
        >;
    }; 

    physical_layout0: physical_layout_0 { 
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>; 
        transform = <&default_transform>;
    };  
};