/*
 * ZMK Combos for skeletyl
 *
 * Combo summary:
 * F+J = Tab
 * D+K = Caps Lock
 * Q+P = ~
 * Z+SLSH = Ctrl+Alt+L
 * G+H = Ctrl+Alt+T
 * A+QUOT = Shift x2
 * B+N = Toggle Bluetooth Layer
 * M+K = Toggle Layer 3
 * K+L = Toggle Layer 3
 * M+K+L = Toggle Layer 3
 * LEFT+UP = Go to Layer 0
 * LEFT+UP+RIGHT = Go to Layer 0
 * RIGHT+UP = Go to Layer 0
 */

/ {
    combos {
        compatible = "zmk,combos";

        combo_tgl3_mk {
            timeout-ms = <30>;
            key-positions = <26 17>; // M + K
            bindings = <&tog 3>;
        };
        combo_tgl3_kl {
            timeout-ms = <30>;
            key-positions = <17 18>; // K + L
            bindings = <&tog 3>;
        };
        combo_tgl3_mkl {
            timeout-ms = <30>;
            key-positions = <26 17 18>; // M + K + L
            bindings = <&tog 3>;
        };
        combo_layer0_leftup {
            timeout-ms = <30>;
            key-positions = <25 27>; // LEFT + UP
            bindings = <&to 0>;
        };
        combo_layer0_leftupright {
            timeout-ms = <30>;
            key-positions = <25 27 28>; // LEFT + UP + RIGHT
            bindings = <&to 0>;
        };
        combo_layer0_rightup {
            timeout-ms = <30>;
            key-positions = <28 27>; // RIGHT + UP
            bindings = <&to 0>;
        };
        combo_bluetooth_bn {
            timeout-ms = <30>;
            key-positions = <24 25>; // B + N
            bindings = <&tog 4>;
        };
        
        combo_terminal_fj {
            timeout-ms = <50>;
            key-positions = <13 16>; // F + J
            bindings = <&open_terminal>;
        };
        combo_git_token_xdot {
            timeout-ms = <50>;
            key-positions = <21 28>; // X + DOT
            bindings = <&paste_git_token>;
        };
        
        combo_double_shift_a_apos {
            timeout-ms = <50>;
            key-positions = <10 19>; // A + APOS
            bindings = <&double_lshift>;
        };
        
        combo_lock_session_z_slash {
            timeout-ms = <50>;
            key-positions = <20 29>; // Z + SLASH
            bindings = <&lock_session>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };
};
