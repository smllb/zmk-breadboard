/*
 * ZMK Combos for skeletyl
 *
 * Combo summary:
 * D+K = One-shot Navigation layer (from default)
 * E+I = One-shot Number layer (from default)
 * C+COMMA = One-shot Symbol layer (from default)
 * Q+P = ~
 * Z+SLSH = Ctrl+Alt+L
 * G+H = Ctrl+Alt+T
 * A+QUOT = Shift x2
 * B+N = Toggle Bluetooth Layer
 * M+K = Switch between Default & Navigation layers
 * LEFT+UP = Go to Default Layer
 * LEFT+UP+RIGHT = Go to Default Layer
 * RIGHT+UP = Go to Default Layer
 * S+D+F = Go to Gaming Layer (Overwatch)
 * G+B = Toggle Gaming Layer (Overwatch)
 * J+K (16+17) = Toggle Symbol Layer from Default / Go back to Default from Symbol Layer
 * D+F (12+13) = Toggle Symbol Layer from Default / Go back to Default from Symbol Layer
 * M+K (26+17) = Toggle Navigation Layer from Default / Go back to Default from Navigation Layer
 * M+COMMA (26+27) = Toggle Function Layer from Default / Go back to Default from Function Layer
 */

// Layer definitions - copied from skeletyl.keymap for consistency
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6
#define BT 7

/ {
    combos {
        compatible = "zmk,combos";
        // === Toggle Layer Combos (25ms timeout) ===
        // --- Layer Toggle Combos (left: 1,2 11,12 21,22; right: 7,8 17,18 27,28) --- 
        // Number Layer
        combo_toggle_num_8_9 {
            timeout-ms = <25>;
            key-positions = <8 9>;
            bindings = <&tog NUMBER>;
            layers = <DEFAULT SYMBOL NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        combo_toggle_num_8_9_to_default {
            timeout-ms = <25>;
            key-positions = <8 9>;
            bindings = <&to DEFAULT>;
            layers = <NUMBER>;
        };
        combo_sticky_num_1_2 {
            timeout-ms = <25>;
            key-positions = <1 2>;
            bindings = <&sl NUMBER>;
            layers = <DEFAULT SYMBOL NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        combo_sticky_num_1_2_to_default {
            timeout-ms = <25>;
            key-positions = <1 2>;
            bindings = <&to DEFAULT>;
            layers = <NUMBER>;
        };
        combo_sticky_num_7_8 {
            timeout-ms = <25>;
            key-positions = <7 8>;
            bindings = <&sl NUMBER>;
            layers = <DEFAULT SYMBOL NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        combo_sticky_num_7_8_to_default {
            timeout-ms = <25>;
            key-positions = <7 8>;
            bindings = <&to DEFAULT>;
            layers = <NUMBER>;
        };
        // Symbol Layer
        combo_sticky_sym_11_12 {
            timeout-ms = <25>;
            key-positions = <11 12>;
            bindings = <&sl SYMBOL>;
            layers = <DEFAULT NUMBER NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        combo_sticky_sym_11_12_to_default {
            timeout-ms = <25>;
            key-positions = <11 12>;
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };
        
        // New combo for toggling symbol layer with D+F (keys 12+13)
        combo_toggle_sym_12_13 {
            timeout-ms = <25>;
            key-positions = <12 13>;
            bindings = <&tog SYMBOL>;
            layers = <DEFAULT NUMBER NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        
        // Return to default when pressing D+F in symbol layer
        combo_sym_12_13_to_default {
            timeout-ms = <25>;
            key-positions = <12 13>;
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };
        

        // New combo for toggling gaming layer with 1 2 3 
        combo_toggle_gaming_1_2_3 {
            timeout-ms = <20>;
            key-positions = <1 2 3>;
            bindings = <&to GAMING>;
            layers = <DEFAULT NUMBER NAVIGATION FUNCTION MEDIA BT>;
        };
        
        // Return to default 
        combo_toggle_gaming_1_2_3_to_default {
            timeout-ms = <15>;
            key-positions = <1 2 3>;
            bindings = <&to DEFAULT>;
            layers = <GAMING>;
        };

        // New combo for toggling navigation layer with M+K (keys 26+17)
        combo_toggle_nav_26_17 {
            timeout-ms = <25>;
            key-positions = <26 17>;
            bindings = <&tog NAVIGATION>;
            layers = <DEFAULT NUMBER SYMBOL FUNCTION MEDIA BT GAMING>;
        };
        
        // Return to default when pressing M+K in navigation layer
        combo_nav_26_17_to_default {
            timeout-ms = <25>;
            key-positions = <26 17>;
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>;
        };
        
        // New combo for toggling function layer with M+COMMA (keys 26+27)
        combo_toggle_func_26_27 {
            timeout-ms = <25>;
            key-positions = <26 27>;
            bindings = <&tog FUNCTION>;
            layers = <DEFAULT NUMBER SYMBOL NAVIGATION MEDIA BT GAMING>;
        };
        
        // Return to default when pressing M+COMMA in function layer
        combo_func_26_27_to_default {
            timeout-ms = <25>;
            key-positions = <26 27>;
            bindings = <&to DEFAULT>;
            layers = <FUNCTION>;
        };
        combo_sticky_sym_17_18 {
            timeout-ms = <25>;
            key-positions = <17 18>;
            bindings = <&sl SYMBOL>;
            layers = <DEFAULT NUMBER NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        combo_sticky_sym_17_18_to_default {
            timeout-ms = <25>;
            key-positions = <17 18>;
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };
        
        // New combo for toggling symbol layer with J+K (keys 16+17)
        combo_toggle_sym_16_17 {
            timeout-ms = <25>;
            key-positions = <16 17>;
            bindings = <&tog SYMBOL>;
            layers = <DEFAULT NUMBER NAVIGATION FUNCTION MEDIA BT GAMING>;
        };
        
        // Return to default when pressing J+K in symbol layer
        combo_sym_16_17_to_default {
            timeout-ms = <25>;
            key-positions = <16 17>;
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };
        // Function Layer
        combo_sticky_fun_21_22 {
            timeout-ms = <25>;
            key-positions = <21 22>;
            bindings = <&sl FUNCTION>;
            layers = <DEFAULT NUMBER SYMBOL NAVIGATION MEDIA BT GAMING>;
        };
        combo_sticky_fun_21_22_to_default {
            timeout-ms = <25>;
            key-positions = <21 22>;
            bindings = <&to DEFAULT>;
            layers = <FUNCTION>;
        };
        combo_sticky_nav_27_28 {
            timeout-ms = <25>;
            key-positions = <27 28>;
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT NUMBER SYMBOL NAVIGATION MEDIA BT GAMING>;
        };
        combo_sticky_nav_27_28_to_default {
            timeout-ms = <25>;
            key-positions = <27 28>;
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>;
        };

        // Toggle GAMING layer with 11 + 2 + 13 (all except GAMING)
        combo_toggle_gaming_11213 {
            timeout-ms = <30>;
            key-positions = <11 2 13>; // 11 + 2 + 13
            bindings = <&tog GAMING>; // Toggle GAMING layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION MEDIA BT>; // All except GAMING
        };

        // Go to BT layer with 30 + 35 (all except BT)
        combo_to_bt_3035 {
            timeout-ms = <30>;
            key-positions = <30 35>; // 30 + 35
            bindings = <&to BT>; // Go to BT layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION MEDIA GAMING>; // All except BT
        };

        // On BT: 30 + 35 returns to DEFAULT
        combo_bt_3035_to_default {
            timeout-ms = <30>;
            key-positions = <30 35>; // 30 + 35
            bindings = <&to DEFAULT>;
            layers = <BT>;
        };
        // Go to BT layer with 3 + 4 (all except BT)
        combo_to_bt_34 {
            timeout-ms = <30>;
            key-positions = <3 4>; // 3 + 4
            bindings = <&to BT>; // Go to BT layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION MEDIA GAMING>; // All except BT
        };

        // On BT: 3 + 4 returns to DEFAULT
        combo_bt_34_to_default {
            timeout-ms = <30>;
            key-positions = <3 4>; // 3 + 4
            bindings = <&to DEFAULT>;
            layers = <BT>;
        };
        // On BT: 20 + 32 + 33 + 29 sends BT_CLR_ALL
        combo_bt_clr_all_20_32_33_29 {
            timeout-ms = <30>;
            key-positions = <20 32 33 29>; // 20 + 32 + 33 + 29
            bindings = <&bt BT_CLR_ALL>;
            layers = <BT>;
        };

        combo_gui_fk {
            timeout-ms = <50>;
            key-positions = <13 16>; // F + K
            bindings = <&kp LGUI>;
        };
        combo_git_token_xdot {
            timeout-ms = <50>;
            key-positions = <21 28>; // X + DOT working
            bindings = <&paste_git_token>;
        };
        
        combo_double_shift_a_apos {
            timeout-ms = <50>;
            key-positions = <10 19>; // A + APOS working 
            bindings = <&double_lshift>;
        };
        
        combo_lock_session_z_slash {
            timeout-ms = <20>;
            key-positions = <20 29>; // Z + SLASH working 
            bindings = <&lock_session>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>; // working
        }; 
        
        combo_alt_f4 {
            timeout-ms = <50>;
            key-positions = <1 17>;     // W + K keys
            bindings = <&alt_f4>;      // Trigger the Alt+F4 macro
            layers = <DEFAULT>;        // Only active on default layer working
        };
        
        combo_terminal_gh {
            timeout-ms = <50>;
            key-positions = <14 25>;   // G + H
            bindings = <&kp LC(LA(T))>; // Ctrl+Alt+T
            layers = <DEFAULT>;        // Only active on default layer not working 
        };
        
        combo_tilde_qp {
            timeout-ms = <50>;
            key-positions = <0 9>;     // Q + P
            bindings = <&kp TILDE>;    // ~ key
            layers = <DEFAULT>;        // Only active on default layer
        };


    };
};
