/*
 * ZMK Combos for skeletyl
 *
 * Combo summary:
 * D+K = Navigate between Default & Text Navigation layer
 * Q+P = ~
 * Z+SLSH = Ctrl+Alt+L
 * G+H = Ctrl+Alt+T
 * A+QUOT = Shift x2
 * B+N = Toggle Bluetooth Layer
 * M+K = Switch between Default & Navigation layers
 * K+L = Switch between Default & Navigation layers
 * M+K+L = Switch between Default & Navigation layers
 * LEFT+UP = Go to Default Layer
 * LEFT+UP+RIGHT = Go to Default Layer
 * RIGHT+UP = Go to Default Layer
 * S+D+F = Go to Gaming Layer (Overwatch)
 * G+B = Toggle Gaming Layer (Overwatch)
 */

// Layer definitions - copied from skeletyl.keymap for consistency
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6

/ {
    combos {
        compatible = "zmk,combos";

        combo_nav_mk {
            timeout-ms = <30>;
            key-positions = <26 17>; // M + K
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT SYMBOL NUMBER FUNCTION MEDIA GAMING>; // All layers except NAVIGATION
        };
        combo_default_mk {
            timeout-ms = <30>;
            key-positions = <26 17>; // M + K
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>; // Only on NAVIGATION layer
        };
        
        combo_nav_kl {
            timeout-ms = <30>;
            key-positions = <17 18>; // K + L
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT SYMBOL NUMBER FUNCTION MEDIA GAMING>; // All layers except NAVIGATION
        };
        combo_default_kl {
            timeout-ms = <30>;
            key-positions = <17 18>; // K + L
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>; // Only on NAVIGATION layer
        };
        
        combo_nav_mkl {
            timeout-ms = <30>;
            key-positions = <26 17 18>; // M + K + L
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT SYMBOL NUMBER FUNCTION MEDIA GAMING>; // All layers except NAVIGATION
        };
        combo_default_mkl {
            timeout-ms = <30>;
            key-positions = <26 17 18>; // M + K + L
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>; // Only on NAVIGATION layer
        };
        };
        combo_layer0_leftup {
            timeout-ms = <30>;
            key-positions = <25 27>; // LEFT + UP
            bindings = <&to DEFAULT>;
        };
        combo_layer0_leftupright {
            timeout-ms = <30>;
            key-positions = <25 27 28>; // LEFT + UP + RIGHT
            bindings = <&to DEFAULT>;
        };
        combo_layer0_rightup {
            timeout-ms = <30>;
            key-positions = <28 27>; // RIGHT + UP
            bindings = <&to DEFAULT>;
        };
        combo_bluetooth_bn {
            timeout-ms = <30>;
            key-positions = <24 25>; // B + N
            bindings = <&tog FUNCTION>;
        };
        
        combo_terminal_sl {
            timeout-ms = <50>;
            key-positions = <14 18>; // S + L
            bindings = <&open_terminal>;
        };
        combo_gui_fk {
            timeout-ms = <50>;
            key-positions = <13 16>; // F + K not working not working 
            bindings = <&kp LGUI>;
        };
        combo_git_token_xdot {
            timeout-ms = <50>;
            key-positions = <21 28>; // X + DOT working
            bindings = <&paste_git_token>;
        };
        
        combo_double_shift_a_apos {
            timeout-ms = <50>;
            key-positions = <10 19>; // A + APOS working 
            bindings = <&double_lshift>;
        };
        
        combo_lock_session_z_slash {
            timeout-ms = <20>;
            key-positions = <20 29>; // Z + SLASH working 
            bindings = <&lock_session>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>; // working
        }; 
        
        combo_gaming_wsd {
            timeout-ms = <50>;
            key-positions = <1 11 12>; // W + S + D
            bindings = <&tog GAMING>;  // Toggle gaming layer working 
        };
        
        combo_gaming_sdf {
            timeout-ms = <50>;
            key-positions = <11 12 13>; // S + D + F
            bindings = <&to GAMING>;   // Go to gaming layer
            layers = <DEFAULT>;        // Only active on default layer working
        };
        
        combo_bt_clear_all {
            timeout-ms = <75>;
            key-positions = <10 19>;    // First and last keys of second row (positions 10 and 19)
            bindings = <&bt BT_CLR_ALL>; // Clear all BT profiles
            layers = <FUNCTION>;        // Only active on Bluetooth/Function layer working
        };
        
        combo_alt_f4 {
            timeout-ms = <50>;
            key-positions = <1 17>;     // W + K keys
            bindings = <&alt_f4>;      // Trigger the Alt+F4 macro
            layers = <DEFAULT>;        // Only active on default layer working
        };
        
        combo_terminal_gh {
            timeout-ms = <50>;
            key-positions = <14 15>;   // G + H
            bindings = <&kp LC(LA(T))>; // Ctrl+Alt+T
            layers = <DEFAULT>;        // Only active on default layer not working 
        };
        
        combo_tilde_qp {
            timeout-ms = <50>;
            key-positions = <0 9>;     // Q + P
            bindings = <&kp TILDE>;    // ~ key
            layers = <DEFAULT>;        // Only active on default layer
        };

        combo_caps_ei {
            timeout-ms = <25>;
            key-positions = <2 7>;     // E + I
            bindings = <&caps_word>;   // Caps Word
        };

        // NEW COMBOS
        combo_nav_dk {
            timeout-ms = <50>;
            key-positions = <12 17>; // D + K
            bindings = <&to SYMBOL>; 
            layers = <DEFAULT>;       // Only active on default layer
        };
        
        combo_default_dk {
            timeout-ms = <50>;
            key-positions = <12 17>; // D + K
            bindings = <&to DEFAULT>; // Go back to default layer
            layers = <SYMBOL NAVIGATION NUMBER FUNCTION MEDIA GAMING>; // Active on all layers except default
        };

    };
};
