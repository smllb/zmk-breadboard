#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Auto-move: Alt+Z+X+C triggers the auto_move toggle
        combo_auto_move {
            timeout-ms = <100>;
            key-positions = <10 11 12 13>;  // Alt Z X C
            bindings = <&auto_move>;
        };
    };
};
