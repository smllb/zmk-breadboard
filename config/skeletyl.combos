/*
 * ZMK Combos for skeletyl
 *
 * Combo summary:
 * D+K = One-shot Navigation layer (from default)
 * E+I = One-shot Number layer (from default)
 * C+COMMA = One-shot Symbol layer (from default)
 * Q+P = ~
 * Z+SLSH = Ctrl+Alt+L
 * G+H = Ctrl+Alt+T
 * A+QUOT = Shift x2
 * B+N = Toggle Bluetooth Layer
 * M+K = Switch between Default & Navigation layers
 * K+L = Switch between Default & Navigation layers
 * M+K+L = Switch between Default & Navigation layers
 * LEFT+UP = Go to Default Layer
 * LEFT+UP+RIGHT = Go to Default Layer
 * RIGHT+UP = Go to Default Layer
 * S+D+F = Go to Gaming Layer (Overwatch)
 * G+B = Toggle Gaming Layer (Overwatch)
 */

// Layer definitions - copied from skeletyl.keymap for consistency
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6

/ {
    combos {
        // Toggle MEDIA layer with 8 + 9 (all except MEDIA)
        combo_toggle_media_89 {
            timeout-ms = <30>;
            key-positions = <8 9>; // 8 + 9
            bindings = <&tog MEDIA>; // Toggle MEDIA layer
            layers = <DEFAULT SYMBOL NAVIGATION NUMBER FUNCTION GAMING>; // All except MEDIA
        };

        // On MEDIA layer: 8 + 9 returns to DEFAULT
        combo_media_89_to_default {
            timeout-ms = <30>;
            key-positions = <8 9>; // 8 + 9
            bindings = <&to DEFAULT>;
            layers = <MEDIA>;
        };
        // On SYMBOL layer: 12+13 and 16+17 send to DEFAULT
        combo_symbol_1213_to_default {
            timeout-ms = <15>;
            key-positions = <12 13>; // 12 + 13
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };
        combo_symbol_1617_to_default {
            timeout-ms = <15>;
            key-positions = <16 17>; // 16 + 17
            bindings = <&to DEFAULT>;
            layers = <SYMBOL>;
        };

        // On FUNCTION layer: 12+13 and 16+17 send to DEFAULT
        combo_function_1213_to_default {
            timeout-ms = <15>;
            key-positions = <12 13>; // 12 + 13
            bindings = <&to DEFAULT>;
            layers = <FUNCTION>;
        };
        combo_function_1617_to_default {
            timeout-ms = <15>;
            key-positions = <16 17>; // 16 + 17
            bindings = <&to DEFAULT>;
            layers = <FUNCTION>;
        };
        // New: Sticky NUMBER layer with 2 + 3
        combo_sticky_number_23 {
            timeout-ms = <15>;
            key-positions = <2 3>; // 2 + 3
            bindings = <&sl NUMBER>; // Sticky NUMBER layer
            layers = <DEFAULT SYMBOL FUNCTION NAVIGATION MEDIA GAMING>; // All except NUMBER
        };

        // New: Sticky SYMBOL layer with 12 + 13
        combo_sticky_symbol_1213 {
            timeout-ms = <15>;
            key-positions = <12 13>; // 12 + 13
            bindings = <&sl SYMBOL>; // Sticky SYMBOL layer
            layers = <DEFAULT FUNCTION NUMBER NAVIGATION MEDIA GAMING>; // All except SYMBOL
        };

        // New: Sticky FUNCTION layer with 22 + 23
        combo_sticky_function_2223 {
            timeout-ms = <15>;
            key-positions = <22 23>; // 22 + 23
            bindings = <&sl FUNCTION>; // Sticky FUNCTION layer
            layers = <DEFAULT SYMBOL NUMBER NAVIGATION MEDIA GAMING>; // All except FUNCTION
        };

        // New: Sticky NUMBER layer with 6 + 7
        combo_sticky_number_67 {
            timeout-ms = <15>;
            key-positions = <6 7>; // 6 + 7
            bindings = <&sl NUMBER>; // Sticky NUMBER layer
            layers = <DEFAULT SYMBOL FUNCTION NAVIGATION MEDIA GAMING>; // All except NUMBER
        };

        // New: Sticky SYMBOL layer with 16 + 17
        combo_sticky_symbol_1617 {
            timeout-ms = <15>;
            key-positions = <16 17>; // 16 + 17
            bindings = <&sl SYMBOL>; // Sticky SYMBOL layer
            layers = <DEFAULT FUNCTION NUMBER NAVIGATION MEDIA GAMING>; // All except SYMBOL
        };

        // New: Sticky FUNCTION layer with 26 + 27
        combo_sticky_function_2627 {
            timeout-ms = <15>;
            key-positions = <26 27>; // 26 + 27
            bindings = <&sl FUNCTION>; // Sticky FUNCTION layer
            layers = <DEFAULT SYMBOL NUMBER NAVIGATION MEDIA GAMING>; // All except FUNCTION
        };
            // On non-DEFAULT layers: 11+12, 17+18, 12+17 send to DEFAULT
            combo_to_default_1112 {
                timeout-ms = <15>;
                key-positions = <11 12>; // 11 + 12
                bindings = <&to DEFAULT>;
                layers = <SYMBOL FUNCTION NUMBER NAVIGATION MEDIA GAMING>;
            };
            combo_to_default_1718 {
                timeout-ms = <15>;
                key-positions = <17 18>; // 17 + 18
                bindings = <&to DEFAULT>;
                layers = <SYMBOL FUNCTION NUMBER NAVIGATION MEDIA GAMING>;
            };
            combo_to_default_1217 {
                timeout-ms = <15>;
                key-positions = <12 17>; // 12 + 17
                bindings = <&to DEFAULT>;
                layers = <SYMBOL FUNCTION NUMBER NAVIGATION MEDIA GAMING>;
            };
        compatible = "zmk,combos";
                // New: Toggle NUMBER layer with 7 + 8
        combo_toggle_number_78 {
            timeout-ms = <15>;
            key-positions = <7 8>; // 7 + 8
            bindings = <&tog NUMBER>; // Toggle NUMBER layer
            layers = <DEFAULT SYMBOL FUNCTION NAVIGATION MEDIA GAMING>; // All except NUMBER
        };

        // New: Toggle SYMBOL layer with 17 + 18
        combo_toggle_symbol_1718 {
            timeout-ms = <15>;
            key-positions = <17 18>; // 17 + 18
            bindings = <&tog SYMBOL>; // Toggle SYMBOL layer
            layers = <DEFAULT FUNCTION NUMBER NAVIGATION MEDIA GAMING>; // All except SYMBOL
        };

        // New: Toggle FUNCTION layer with 27 + 28
        combo_toggle_function_2728 {
            timeout-ms = <15>;
            key-positions = <27 28>; // 27 + 28
            bindings = <&tog FUNCTION>; // Toggle FUNCTION layer
            layers = <DEFAULT SYMBOL NUMBER NAVIGATION MEDIA GAMING>; // All except FUNCTION
        };

        // New: Toggle NUMBER layer with 1 + 2
        combo_toggle_number_12 {
            timeout-ms = <15>;
            key-positions = <1 2>; // 1 + 2
            bindings = <&tog NUMBER>; // Toggle NUMBER layer
            layers = <DEFAULT SYMBOL FUNCTION NAVIGATION MEDIA GAMING>; // All except NUMBER
        };

        // New: Toggle SYMBOL layer with 11 + 12
        combo_toggle_symbol_1112 {
            timeout-ms = <15>;
            key-positions = <11 12>; // 11 + 12
            bindings = <&tog SYMBOL>; // Toggle SYMBOL layer
            layers = <DEFAULT FUNCTION NUMBER NAVIGATION MEDIA GAMING>; // All except SYMBOL
        };

        // New: Toggle FUNCTION layer with 21 + 22
        combo_toggle_function_2122 {
            timeout-ms = <15>;
            key-positions = <21 22>; // 21 + 22
            bindings = <&tog FUNCTION>; // Toggle FUNCTION layer
            layers = <DEFAULT SYMBOL NUMBER NAVIGATION MEDIA GAMING>; // All except FUNCTION
        };

        combo_gui_fk {
            timeout-ms = <50>;
            key-positions = <13 16>; // F + K not working not working 
            bindings = <&kp LGUI>;
        };
        combo_git_token_xdot {
            timeout-ms = <50>;
            key-positions = <21 28>; // X + DOT working
            bindings = <&paste_git_token>;
        };
        
        combo_double_shift_a_apos {
            timeout-ms = <50>;
            key-positions = <10 19>; // A + APOS working 
            bindings = <&double_lshift>;
        };
        
        combo_lock_session_z_slash {
            timeout-ms = <20>;
            key-positions = <20 29>; // Z + SLASH working 
            bindings = <&lock_session>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>; // working
        }; 
        
        combo_alt_f4 {
            timeout-ms = <50>;
            key-positions = <1 17>;     // W + K keys
            bindings = <&alt_f4>;      // Trigger the Alt+F4 macro
            layers = <DEFAULT>;        // Only active on default layer working
        };
        
        combo_terminal_gh {
            timeout-ms = <50>;
            key-positions = <14 15>;   // G + H
            bindings = <&kp LC(LA(T))>; // Ctrl+Alt+T
            layers = <DEFAULT>;        // Only active on default layer not working 
        };
        
        combo_tilde_qp {
            timeout-ms = <50>;
            key-positions = <0 9>;     // Q + P
            bindings = <&kp TILDE>;    // ~ key
            layers = <DEFAULT>;        // Only active on default layer
        };



        // NEW COMBOS
        combo_sticky_nav_dk {
            timeout-ms = <50>;
            key-positions = <12 17>; // D + K
            bindings = <&sl SYMBOL>; // Sticky layer for SYMBOL
            layers = <DEFAULT>;       // Only active on default layer
        };


        combo_nav_mk {
            timeout-ms = <30>;
            key-positions = <26 17>; // M + K
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT SYMBOL NUMBER FUNCTION MEDIA GAMING>; // All layers except NAVIGATION
        };
        combo_default_mk {
            timeout-ms = <30>;
            key-positions = <26 17>; // M + K
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>; // Only on NAVIGATION layer
        };
        
        
        combo_nav_mkl {
            timeout-ms = <30>;
            key-positions = <26 17 18>; // M + K + L
            bindings = <&to NAVIGATION>;
            layers = <DEFAULT SYMBOL NUMBER FUNCTION MEDIA GAMING>; // All layers except NAVIGATION
        };
        combo_default_mkl {
            timeout-ms = <30>;
            key-positions = <26 17 18>; // M + K + L
            bindings = <&to DEFAULT>;
            layers = <NAVIGATION>; // Only on NAVIGATION layer
        };
        
        combo_sticky_number {
            timeout-ms = <30>;
            key-positions = <2 7>;     // E + I
            bindings = <&sl NUMBER>;   // Sticky NUMBER layer
            layers = <DEFAULT>;        // Only active on default layer
        };
        
        combo_sticky_symbol {
            timeout-ms = <30>;
            key-positions = <22 27>;   // C + COMMA
            bindings = <&sl FUNCTION>;   // Sticky FUNCTION layer
            layers = <DEFAULT>;        // Only active on default layer
        };
        
        // New: Toggle NUMBER layer with W + O (positions 1 + 8)
        combo_toggle_number_wo {
            timeout-ms = <30>;
            key-positions = <1 8>; // W + O
            bindings = <&tog NUMBER>; // Toggle NUMBER layer
        };
        
        // New: Toggle NAVIGATION layer with S + L (positions 11 + 18)
        combo_toggle_nav_sl {
            timeout-ms = <30>;
            key-positions = <11 18>; // S + L
            bindings = <&tog SYMBOL>; // Toggle SYMBOL layer
        };
        
        // New: Toggle SYMBOL layer with X + DOT (positions 21 + 28)
        combo_toggle_symbol_xdot {
            timeout-ms = <30>;
            key-positions = <21 28>; // X + DOT
            bindings = <&tog FUNCTION>; // Toggle FUNCTION layer
        };
    };
};
