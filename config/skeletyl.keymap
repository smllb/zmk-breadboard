#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>

/ {
    behaviors {
        tg_d: toggle_d {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&tog>, <&kp>;
            display-name = "Toggle-D";
        };
        
        tg_k: toggle_k {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&tog>, <&kp>;
            display-name = "Toggle-K";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                &mt LSHIFT A  &kp S      &tg_d 3 D     &lt 1 F      &kp G      &kp H      &lt 1 J      &tg_k 3 K      &kp L      &mt LSHIFT APOS
                &mt LCTRL Z   &kp X      &kp C      &lt 2 V       &kp B      &kp N      &lt 2 M       &kp COMMA  &kp DOT    &mt RCTRL SLASH
                                   &none      &none      &kp LSHIFT &kp ESC   &kp SPACE  &kp BSPC   &mt LALT ENTER  &none
            >;
        };
    };
};
