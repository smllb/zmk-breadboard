#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include "skeletyl.combos"

// Layer definitions
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6

/ {
    behaviors {   
        // Configure the built-in mod-tap behavior to use tap-preferred
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Hold-preferred mod-tap for specific keys
        mth: mod_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Balanced mod-tap for testing
        mtb: mod_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Long sticky key behavior - 15 seconds
        long_sk: sticky_key_long {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <15000>;
            bindings = <&kp>;
            quick-release;
        };
        /**
        * Temporarily switches to a layer (`&mo`) while a modifier is held.
        * Analogous to QMK's `LM()`, using a parameterized macro.
        *
        * Params:
        *  1. Layer to switch to
        *  2. Modifier to press while layer is active
        *
        * Example:
        *  `&lm NUM_LAYER LSHIFT`
        */
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };

    macros {
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT>
                ;
        };

                open_terminal: open_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(T))>;
        };

            double_lshift: double_lshift {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <
                    &macro_tap &kp LSHFT &kp LSHFT
                >;
            };

        paste_git_token: paste_git_token {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LC(RA(P))
            >;
        };

            alt_tab_macro: alt_tab_macro {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = 
                    <&macro_press &kp LA(TAB)>,  // Press Alt+Tab
                    <&macro_release &kp TAB>,    // Release Tab, keep Alt pressed
                    <&to MEDIA>,         // Switch to media layer (used as alt_tab layer)
                    <&macro_release &kp LALT>    // Release Alt when leaving the layer
                ;
            };
            
            lock_session: lock_session {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(LA(L))>;  // Ctrl+Alt+L to lock session on Linux Mint
            };
            
            quick_melee: quick_melee {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp V>;  // V is default melee in Overwatch
            };
            
            quick_hello: quick_hello {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(C)>;  // Ctrl+C is a common binding for "Hello" in Overwatch
            };
            
            toggle_gaming: toggle_gaming {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&tog GAMING>;  // Toggle gaming layer
            };
            
            alt_f4: alt_f4 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LA(F4)>;  // Alt+F4 to close windows
            };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W      &kp E       &kp R        &kp T      &kp Y      &kp U        &kp I      &kp O      &kp P
                &mt LSHIFT A  &kp S      &kp D       &kp F        &kp G      &kp H      &kp J        &kp K      &kp L      &kp APOS
                &mt LCTRL Z   &mt LALT X &kp C       &kp V        &kp B      &kp N      &kp M        &kp COMMA  &kp DOT    &kp SLASH
                                        &none       &none        &kp SPACE  &kp ENTER  &none        &none
            >;
        };

        symbol_layer {
            bindings = <
                &kp TILDE    &kp EXCL   &kp AT     &kp DLLR    &kp AMPS   &kp RBKT   &kp COLON  &kp SEMI   &kp MINUS  &kp EQUAL
                &kp HASH     &kp CARET  &kp PRCNT  &kp ASTRK   &trans     &kp LBKT   &kp LPAR   &kp RPAR   &kp UNDER  &kp PLUS
                &trans       &trans     &trans     &trans      &trans     &kp BSLH   &kp LBRC   &kp RBRC   &kp PIPE   &trans
                                        &trans     &trans      &trans     &trans     &kp BSPC   &trans
            >;
        };

        text_navigation_layer {
            bindings = <
                &kp A        &kp V      &kp LALT   &kp TAB    &none      &kp R       &kp F        &kp Y     &kp BSPC     &kp PG_UP
                &kp LSHIFT   &kp X      &kp C      &kp LCTRL  &kp G      &kp B       &kp HOME     &kp UP    &kp RIGHT    &kp DEL
                &kp Z        &none      &kp F4     &kp F5     &none      &kp D       &kp LEFT     &kp DOWN  &kp END      &kp PG_DN
                                        &none      &kp SLASH  &kp SPACE  &kp ENTER   &kp BSPC     &none
            >;
        };

        num_layer {
            bindings = <
                &kp N1       &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
                &trans       &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans       &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                                        &trans     &trans     &trans     &trans     &kp BSPC   &trans
            >;
        };

        fn_layer {
            bindings = <
                &kp F1       &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
                &kp F11      &kp F12    &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans       &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                                        &trans     &trans     &trans     &trans     &kp BSPC   &trans
            >;
        };

        general_media {
            bindings = <
                &trans       &trans     &trans     &trans     &trans     &kp C_PREV  &kp C_VOL_DN &kp C_PP  &kp C_VOL_UP &kp C_NEXT
                &trans       &trans     &trans     &trans     &trans     &trans      &trans       &trans    &trans       &trans
                &trans       &trans     &trans     &trans     &trans     &trans      &trans       &trans    &trans       &trans
                                        &none      &to DEFAULT      &none      &none       &none        &none
            >;
        };

        gaming_layer {
            bindings = <
                &kp ESC       &kp Q      &kp W       &kp E        &kp R      &kp N2     &kp N3      &kp I      &kp O      &to DEFAULT
                &kp LSHFT      &kp A      &kp S       &kp D        &kp N4     &kp N5     &kp H       &kp J      &kp L      &kp RET
                &long_sk W &kp Z      &kp X       &kp C        &kp V      &quick_hello &kp M      &kp TAB    &kp DOT    &to DEFAULT
                                        &kp LSHIFT  &kp LCTRL    &kp SPACE  &kp Q      &quick_melee &kp F
            >;
        };
    };
};
