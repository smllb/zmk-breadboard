#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include "skeletyl.combos"

// Configure the built-in sticky layer behavior
&sl {
    release-after-ms = <5000>;
    quick-release;
};

// Layer definitions
#define DEFAULT 0
#define SYMBOL 1
#define NAVIGATION 2
#define NUMBER 3
#define FUNCTION 4
#define MEDIA 5
#define GAMING 6
#define BT 7
#define TAB_LAYER 8

/ {
    behaviors {
        // Mod-morph: O normally, BSPC when Left Shift is held, O uppercase when Right Shift is held
        mm_o_bspc: mod_morph_o_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp O &kp BSPC>;
            mods = <(MOD_LSFT)>;
        };
        
        // Mod-morph: I normally, BSPC when Left Shift is held, I uppercase when Right Shift is held
        mm_i_bspc: mod_morph_i_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp I &kp BSPC>;
            mods = <(MOD_LSFT)>;
        };
        
        // Mod-morph: U normally, BSPC when Left Shift is held, U uppercase when Right Shift is held
        mm_u_bspc: mod_morph_u_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp U &kp BSPC>;
            mods = <(MOD_LSFT)>;
        };
        
        // Mod-morph: Y normally, BSPC when Left Shift is held, Y uppercase when Right Shift is held
        mm_y_bspc: mod_morph_y_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Y &kp BSPC>;
            mods = <(MOD_LSFT)>;
        };
        // Configure the built-in mod-tap behavior to use tap-preferred
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Hold-preferred mod-tap for specific keys
        mth: mod_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Balanced mod-tap for testing
        mtb: mod_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Long sticky key behavior - 15 seconds
        long_sk: sticky_key_long {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <30000>;
            bindings = <&kp>;
            quick-release;
        };
        
        // Removed tap-dance related code
        
        
        /**
        * Temporarily switches to a layer (`&mo`) while a modifier is held.
        * Analogous to QMK's `LM()`, using a parameterized macro.
        *
        * Params:
        *  1. Layer to switch to
        *  2. Modifier to press while layer is active
        *
        * Example:
        *  `&lm NUM_LAYER LSHIFT`
        */
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo TAB>
                , <&macro_param_2to1>
                , <&macro_press &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp LALT>
                , <&macro_param_1to1>
                , <&macro_release &mo TAB>
                ;
        };
        
        // Toggle on tap, momentary on hold behavior
        tog_mo: toggle_momentary {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
        
    };

    macros {
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT>
                ;
        };

                open_terminal: open_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(T))>;
        };

            double_lshift: double_lshift {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <
                    &macro_tap &kp LSHFT &kp LSHFT
                >;
            };

        paste_git_token: paste_git_token {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LC(RA(P))
            >;
        };

            
            lock_session: lock_session {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(LA(L))>;  // Ctrl+Alt+L to lock session on Linux Mint
            };
            
            quick_melee: quick_melee {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp V>;  // V is default melee in Overwatch
            };
            
            quick_hello: quick_hello {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(C)>;  // Ctrl+C is a common binding for "Hello" in Overwatch
            };
            
            toggle_gaming: toggle_gaming {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&tog GAMING>;  // Toggle gaming layer
            };
            
            alt_f4: alt_f4 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LA(F4)>;  // Alt+F4 to close windows
            };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q         &kp W         &mt RSHIFT E   &lt FUNCTION R         &kp T         &mm_y_bspc &mm_u_bspc &mm_i_bspc   &mm_o_bspc &lt TAB_LAYER P
                &mtb LSHIFT A &kp S         &mt LCTRL D   &lt SYMBOL F         &kp G         &kp H         &lt SYMBOL  J         &lt SYMBOL K   &kp L         &mt LSHIFT APOS
                &mt LCTRL Z   &mt RCTRL X    &lt NUMBER C &lt NUMBER V         &kp B         &kp N         &lt NUMBER M         &lt NUMBER COMMA &mt RCTRL DOT   &mt LCTRL SLASH
                &kp X         &none         &kp SPACE    &kp ENTER     &tog_mo NAVIGATION NAVIGATION     &kp Z
            >;
        };

        symbol_layer {
            bindings = <
                &kp TILDE     &kp EXCL      &lt NUMBER AT  &kp DLLR      &kp AMPS      &kp RBKT      &kp COLON     &lt NUMBER SEMI &kp MINUS     &kp EQUAL
                &kp HASH      &kp CARET     &lt SYMBOL PRCNT &kp ASTRK    &trans        &kp LBKT      &kp LPAR      &lt SYMBOL RPAR &kp UNDER     &kp PLUS
                &trans        &trans        &trans        &trans        &trans        &kp BSLH      &kp LBRC      &trans        &kp PIPE      &trans
                &trans        &trans        &trans        &trans        &kp BSPC      &trans
            >;
        };

        navigation_layer {
            bindings = <
                &kp A         &kp V         &kp LALT &kp TAB       &none         &kp R         &kp BSPC      &kp UP        &kp RIGHT     &kp BSPC
                &kp LSHIFT    &kp X         &kp C    &kp LCTRL     &kp G         &kp B         &kp LEFT      &kp DOWN      &kp END       &kp PG_UP
                &kp Z         &none         &kp F4   &kp F5        &none         &kp D         &kp HOME      &kp F         &kp Y         &kp PG_DN
                &none         &kp SLASH     &kp SPACE     &kp ENTER     &to 0    &kp DEL
            >;
        };

        num_layer {
            bindings = <
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
                &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &kp BSPC      &trans
            >;
        };

        fn_layer {
            bindings = <
                &kp F1        &kp F2        &lt NUMBER F3   &kp F4        &kp F5        &kp F6        &kp F7        &lt NUMBER F8   &kp F9        &kp F10
                &kp F11       &kp F12       &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &kp BSPC      &trans
            >;
        };

        general_media {
            bindings = <
                &trans        &trans        &trans        &trans        &trans        &kp C_PREV    &kp C_VOL_DN     &kp I      &kp C_VOL_UP  &kp C_NEXT
                &trans        &trans        &trans        &trans        &trans        &trans           &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &trans        &kp C_MUTE       &trans        &trans        &trans        &trans
                &none         &to DEFAULT   &none         &none         &none         &none
            >;
        };

        gaming_layer {
            bindings = <
                &kp ESC       &kp Q         &kp W    &kp E         &kp R         &kp N2        &kp N3        &lt NUMBER I    &kp O         &to DEFAULT
                &kp LSHIFT  &kp A         &kp S    &kp D         &kp N4        &kp N5        &kp H         &lt SYMBOL J    &kp L         &kp RET
                &long_sk W    &kp Z         &kp X  &kp C         &kp V         &quick_hello  &kp M         &lt FUNCTION TAB &kp DOT      &to DEFAULT
                &kp TAB  &kp LCTRL     &kp SPACE     &kp Q         &quick_melee   &kp F
            >;
        };

        BT {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &none         &none       &none        &none            &none
                &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4         &none         &none         &none         &bt BT_NXT      &none
                &none       &none         &none         &none         &none         &bt BT_CLR         &bt BT_PRV         &none         &none         &none
                &to DEFAULT         &none         &none         &none         &none         &to DEFAULT
            >;
        };

        tab_layer {
            bindings = <
                &kp ESC       &none         &kp LS(TAB)   &kp TAB       &none         &none         &none         &none         &none         &none
                &kp CAPS      &kp F5         &kp LA(LS(TAB)) &kp LA(TAB) &none         &none         &none         &none         &none         &none
                &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
                &kp LGUI         &none         &none         &kp F5         &none         &none
            >;
        };
    };
};
