#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include "skeletyl.combos"

/ {
    behaviors {   
        // Configure the built-in mod-tap behavior to use tap-preferred
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Hold-preferred mod-tap for specific keys
        mth: mod_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Balanced mod-tap for testing
        mtb: mod_tap_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        
        // Long sticky key behavior - 15 seconds
        long_sk: sticky_key_long {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <15000>;
            bindings = <&kp>;
            quick-release;
        };
        /**
        * Temporarily switches to a layer (`&mo`) while a modifier is held.
        * Analogous to QMK's `LM()`, using a parameterized macro.
        *
        * Params:
        *  1. Layer to switch to
        *  2. Modifier to press while layer is active
        *
        * Example:
        *  `&lm NUM_LAYER LSHIFT`
        */
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };

    macros {
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT>
                ;
        };

                open_terminal: open_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(T))>;
        };

            double_lshift: double_lshift {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <
                    &macro_tap &kp LSHFT &kp LSHFT
                >;
            };

        paste_git_token: paste_git_token {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &kp LC(RA(P))
            >;
        };

            alt_tab_macro: alt_tab_macro {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = 
                    <&macro_press &kp LA(TAB)>,  // Press Alt+Tab
                    <&macro_release &kp TAB>,    // Release Tab, keep Alt pressed
                    <&to 5>,         // Switch to alt_tab_layer
                    <&macro_release &kp LALT>    // Release Alt when leaving the layer
                ;
            };
            
            lock_session: lock_session {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(LA(L))>;  // Ctrl+Alt+L to lock session on Linux Mint
            };
            
            quick_melee: quick_melee {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp V>;  // V is default melee in Overwatch
            };
            
            quick_hello: quick_hello {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LC(C)>;  // Ctrl+C is a common binding for "Hello" in Overwatch
            };
            
            toggle_gaming: toggle_gaming {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&tog 6>;  // Toggle gaming layer
            };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W      &kp E       &kp R        &kp T      &kp Y      &kp U        &kp I      &kp O      &lt 5 P
                &mt LSHIFT A &kp S      &lt 3 D     &lt 1 F      &kp G      &kp H      &lt 1 J      &lt 3 K    &kp L      &mtb LSHIFT APOS
                &mt LCTRL Z  &mt LALT X      &kp C       &lt 2 V      &kp B      &kp N      &lt 2 M      &kp COMMA  &kp DOT    &mth RCTRL SLASH
                                        &tog 4  &kp ESC      &kp SPACE  &kp BSPC   &mt LALT ENTER &lm 5 LALT
            >;
        };

        symbol_layer {
            bindings = <
                &kp TILDE    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp RBKT   &kp SEMI   &kp COLON  &kp MINUS  &kp EQUAL
                &kp ASTRK    &kp PRCNT  &kp CARET  &kp AMPS   &kp SEMI   &kp LBKT   &kp LPAR   &kp RPAR   &kp UNDER  &kp PLUS
                &kp F4       &kp F5     &kp DEL   &kp RIGHT  &kp COLON  &to 0      &kp LBRC   &kp RBRC   &kp BSLH   &kp PIPE
                                        &kp LSHIFT &kp ESC    &kp SPACE  &kp BSPC   &mt LALT ENTER &trans
            >;
        };

        function_layer {
            bindings = <
                &kp N1       &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7       &kp N8     &kp N9     &kp N0
                &mt LSHIFT F1 &kp F2    &kp F3     &to 0      &to 0      &to 0      &lt 0 F11  &kp F7     &kp F8     &mt LSHIFT F9
                &kp F4       &kp F5     &kp F6     &kp LEFT   &kp RIGHT  &trans      &kp F10      &kp COMMA    &kp DOT    &kp F12
                                        &kp LSHIFT &mt LCTRL ESC &kp SPACE &kp BSPC &tog 2       &to 0
            >;
        };

        media_layer {
            bindings = <
                &kp ESC      &trans      &kp HOME   &sl 1      &trans      &trans      &trans      &kp C_VOL_DN &kp C_PP   &kp C_VOL_UP
                &mt LSHIFT A &kp TAB    &kp END    &kp LSHIFT &trans      &trans      &kp LALT   &kp UP      &kp RIGHT  &kp LALT
                &kp LCTRL    &trans      &kp C      &kp V      &trans      &kp C_MUTE &kp LEFT   &kp DOWN    &kp PG_UP  &kp PG_DN
                                        &kp LALT   &mt LCTRL ESC &kp SPACE &kp BSPC &mt LALT ENTER &to 0
            >;
        };

        bluetooth_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans      &trans      &trans      &trans       &bt BT_CLR
                &bt BT_PRV    &bt BT_NXT   &trans        &trans        &trans        &trans      &trans      &trans      &out OUT_TOG &bt BT_CLR_ALL
                &trans   &trans       &trans        &trans        &trans        &trans      &trans      &trans      &trans       &trans
                                          &to 0        &trans        &trans        &trans      &trans      &to 0
            >;
        };

        alt_tab_layer {
            bindings = <
                &trans        &trans      &kp LA(LS(TAB))  &kp LA(TAB) &trans       &trans      &trans      &trans      &trans      &trans
                &trans        &trans      &kp LS(TAB)      &kp TAB &trans       &trans      &kp LA(LS(TAB)) &trans      &trans      &trans
                &trans        &trans      &trans           &kt LALT    &trans       &trans      &trans      &trans      &trans      &trans
                                        &trans        &trans      &kp LA(TAB) &trans   &to 0   &trans      
            >;
        };

        gaming_layer {
            bindings = <
                &kp ESC       &kp Q      &kp W       &kp E        &kp R      &kp N2     &kp N3      &kp I      &kp O      &to 0
                &kp LSHFT      &kp A      &kp S       &kp D        &kp N4     &kp N5     &kp H       &kp J      &kp L      &kp RET
                &long_sk W &kp Z      &kp X       &kp C        &kp V      &quick_hello &kp M      &kp TAB    &kp DOT    &to 0
                                        &kp LSHIFT  &kp LCTRL    &kp SPACE  &kp Q      &quick_melee &kp F
            >;
        };
    };
};
