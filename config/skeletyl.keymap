#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>

// Configure the built-in sticky layer behavior
&sl {
    release-after-ms = <5000>;
    quick-release;
};

// Layer definitions
#define GAMING 0

/ {
    behaviors {
        auto_move: auto_move {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt W>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        gaming_layer {
            bindings = <
                &kp TAB       &kp Q         &kp W    &kp E         &kp R         &none         &none         &none         &none         &none
                &kp LSHIFT    &kp A         &kp S    &kp D         &kp F         &none         &none         &none         &none         &none
                &kp LALT      &kp Z         &kp X    &kp C         &kp V         &none         &none         &none         &none         &none
                &kp T         &kp G         &kp SPACE &none        &none         &none
            >;
        };
    };
};
